@model AutoServiceCenter.Web.ViewModels.Appointment.AppointmentViewModel
@{
	ViewData["Title"] = "Appointment Details";
}
@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
	<h1>@ViewData["Title"]</h1>
	<div class="row">
		<div class="col-md-6">
			<dl class="row">
				<dt class="col-sm-4">Customer</dt>
				<dd class="col-sm-8">@Model.CustomerName</dd>
				<dt class="col-sm-4">Vehicle</dt>
				<dd class="col-sm-8">@Model.VehicleLicensePlate</dd>
				<dt class="col-sm-4">Service</dt>
				<dd class="col-sm-8">@Model.ServiceName</dd>
				<dt class="col-sm-4">Mechanic</dt>
				<dd class="col-sm-8">@Model.MechanicName</dd>
				<dt class="col-sm-4">Date</dt>
				<dd class="col-sm-8">@Model.AppointmentDate.ToString("g")</dd>
				<dt class="col-sm-4">Status</dt>
				<dd class="col-sm-8">@Model.Status</dd>
				<dt class="col-sm-4">Notes</dt>
				<dd class="col-sm-8">@Model.Notes</dd>
			</dl>
			<div>
				<a asp-action="Index" class="btn btn-primary">Back to List</a>
				@if (User.Identity?.IsAuthenticated == true)
				{
					<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
				}
			</div>
		</div>
	</div>
</div>