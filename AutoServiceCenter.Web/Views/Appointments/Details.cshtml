@model AutoServiceCenter.Web.ViewModels.Appointment.AppointmentViewModel
@{
    ViewData["Title"] = "Appointment Details";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" asp-fallback-test-class="btn" asp-fallback-test-property="display" asp-fallback-test-value="inline-block" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <dl class="row">
        <dt class="col-sm-3">Customer Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Customer Email</dt>
        <dd class="col-sm-9">@Model.CustomerEmail</dd>
        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">@Model.VehicleLicensePlate</dd>
        <dt class="col-sm-3">Service</dt>
        <dd class="col-sm-9">@Model.ServiceName</dd>
        <dt class="col-sm-3">Mechanic</dt>
        <dd class="col-sm-9">@Model.MechanicName</dd>
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.AppointmentDate.ToString("g")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@Model.Notes</dd>
    </dl>
    <div>
        @if (User.IsInRole("Administrator") || User.IsInRole("Mechanic") || (User.Identity?.IsAuthenticated == true && Model.CustomerEmail == User.Identity.Name))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        }
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
}