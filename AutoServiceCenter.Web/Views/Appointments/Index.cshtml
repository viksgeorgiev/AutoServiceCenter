@using AutoServiceCenter.Web.ViewModels.Appointment
@model AutoServiceCenter.Web.ViewModels.Appointment.AppointmentIndexViewModel
@{
    ViewData["Title"] = "Appointments";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <div class="row mb-3">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex">
                <input class="form-control me-2" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by customer, vehicle, service, or notes" aria-label="Search">
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-md-6 text-md-end">
                <a asp-action="Create" class="btn btn-success">Create New Appointment</a>
            </div>
        }
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Service</th>
                <th>Mechanic</th>
                <th>Date</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AppointmentViewModel appointment in Model.Appointments)
            {
                <tr>
                    <td>@appointment.CustomerName</td>
                    <td>@appointment.VehicleLicensePlate</td>
                    <td>@appointment.ServiceName</td>
                    <td>@appointment.MechanicName</td>
                    <td>@appointment.AppointmentDate.ToString("g")</td>
                    <td>@appointment.Status</td>
                    <td>@(appointment.Notes.Length > 50 ? appointment.Notes.Substring(0, 50) + "..." : appointment.Notes)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-info btn-sm">Details</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-action="Edit" asp-route-id="@appointment.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@appointment.Id" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm">@i</a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>