@model AutoServiceCenter.Web.ViewModels.ErrorViewModel
@{
	ViewData["Title"] = "Page Not Found";
}
@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
	<div class="row">
		<div class="col-12 text-center">
			<img src="https://market-resized.envatousercontent.com/graphicriver.net/files/254468894/pre-01.jpg?auto=format&q=94&cf_fit=crop&gravity=top&h=8000&w=590&s=d6a4c9176cb87b5438ce0b134565d3b4c362c0dfc2628585b0431de05f35b66a" alt="404 Image" class="img-fluid mb-4" style="max-width: 300px;" />
			<h1 class="text-danger">404 - Page Not Found</h1>
			<p>Sorry, the page you are looking for does not exist.</p>
			@if (Model.ShowRequestId)
			{
				<p><strong>Request ID:</strong> @Model.RequestId</p>
			}
			<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
		</div>
	</div>
</div>