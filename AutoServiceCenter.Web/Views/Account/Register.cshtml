@model AutoServiceCenter.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" asp-fallback-test-class="btn" asp-fallback-test-property="display" asp-fallback-test-value="inline-block" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-md-4">
	        <form asp-action="Register" method="post">
		        @Html.AntiForgeryToken()
		        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
		        <div class="form-group">
			        <label asp-for="Email"></label>
			        <input asp-for="Email" class="form-control"/>
			        <span asp-validation-error-for="Email" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="Password"></label>
			        <input asp-for="Password" class="form-control"/>
			        <span asp-validation-error-for="Password" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="ConfirmPassword"></label>
			        <input asp-for="ConfirmPassword" class="form-control"/>
			        <span asp-validation-error-for="ConfirmPassword" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="Name"></label>
			        <input asp-for="Name" class="form-control"/>
			        <span asp-validation-error-for="Name" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="Address"></label>
			        <input asp-for="Address" class="form-control"/>
			        <span asp-validation-error-for="Address" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="VehicleMake"></label>
			        <input asp-for="VehicleMake" class="form-control"/>
			        <span asp-validation-error-for="VehicleMake" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="VehicleModel"></label>
			        <input asp-for="VehicleModel" class="form-control"/>
			        <span asp-validation-error-for="VehicleModel" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="VehicleYear"></label>
			        <input asp-for="VehicleYear" class="form-control" type="number"/>
			        <span asp-validation-error-for="VehicleYear" class="text-danger"></span>
		        </div>
		        <div class="form-group">
			        <label asp-for="VehicleLicensePlate"></label>
			        <input asp-for="VehicleLicensePlate" class="form-control"/>
			        <span asp-validation-error-for="VehicleLicensePlate" class="text-danger"></span>
		        </div>
		        <input type="hidden" asp-for="@ViewData["ReturnUrl"]"/>
		        <button type="submit" class="btn btn-primary">Register</button>
	        </form>
            <div>
                <p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Already have an account? Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}