@using AutoServiceCenter.Web.ViewModels.Appointment
@using AutoServiceCenter.Web.ViewModels.Vehicle
@model AutoServiceCenter.Web.ViewModels.Customer.CustomerViewModel
@{
    ViewData["Title"] = "Customer Details";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" asp-fallback-test-class="btn" asp-fallback-test-property="display" asp-fallback-test-value="inline-block" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>
        <dt class="col-sm-3">Vehicle Count</dt>
        <dd class="col-sm-9">@Model.VehicleCount</dd>
        <dt class="col-sm-3">Appointment Count</dt>
        <dd class="col-sm-9">@Model.AppointmentCount</dd>
    </dl>
    <h3>Vehicles</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Make</th>
                <th>Model</th>
                <th>Year</th>
                <th>License Plate</th>
            </tr>
        </thead>
        <tbody>
            @foreach (VehicleViewModel vehicle in Model.Vehicles)
            {
                <tr>
                    <td>@vehicle.Make</td>
                    <td>@vehicle.Model</td>
                    <td>@vehicle.Year</td>
                    <td>@vehicle.LicensePlate</td>
                </tr>
            }
        </tbody>
    </table>
    <h3>Appointments</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Vehicle</th>
                <th>Service</th>
                <th>Mechanic</th>
                <th>Date</th>
                <th>Status</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AppointmentViewModel appointment in Model.Appointments)
            {
                <tr>
                    <td>@appointment.Name</td>
                    <td>@appointment.VehicleLicensePlate</td>
                    <td>@appointment.ServiceName</td>
                    <td>@appointment.MechanicName</td>
                    <td>@appointment.AppointmentDate.ToString("g")</td>
                    <td>@appointment.Status</td>
                    <td>@(appointment.Notes.Length > 50 ? appointment.Notes.Substring(0, 50) + "..." : appointment.Notes)</td>
                </tr>
            }
        </tbody>
    </table>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
}