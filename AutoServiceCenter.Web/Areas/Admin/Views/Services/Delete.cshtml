@model AutoServiceCenter.Web.ViewModels.Services.ServiceViewModel
@{
	ViewData["Title"] = "Delete Service";
}
@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
	<h1>@ViewData["Title"]</h1>
	<h3>Are you sure you want to delete this service?</h3>
	<div class="row">
		<div class="col-md-6">
			<dl class="row">
				<dt class="col-sm-4">Name</dt>
				<dd class="col-sm-8">@Model.Name</dd>
				<dt class="col-sm-4">Description</dt>
				<dd class="col-sm-8">@Model.Description</dd>
				<dt class="col-sm-4">Price</dt>
				<dd class="col-sm-8">@Model.Price.ToString("C")</dd>
				<dt class="col-sm-4">Appointments</dt>
				<dd class="col-sm-8">@Model.AppointmentCount</dd>
			</dl>
			<form asp-action="Delete" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="Id"/>
				<button type="submit" class="btn btn-danger">Delete</button>
				<a asp-action="Index" class="btn btn-secondary">Cancel</a>
			</form>
		</div>
	</div>
</div>