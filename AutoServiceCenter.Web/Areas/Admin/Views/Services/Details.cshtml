@using AutoServiceCenter.Web.ViewModels.Appointment
@model AutoServiceCenter.Web.ViewModels.Services.ServiceViewModel

@{
    ViewData["Title"] = "Service Details";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>
                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>
                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
                <dt class="col-sm-4">Appointments</dt>
                <dd class="col-sm-8">@Model.AppointmentCount</dd>
            </dl>
            <h3>Appointments</h3>
            @if (Model.Appointments.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Mechanic</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AppointmentViewModel appointment in Model.Appointments)
                        {
	                        <tr>
		                        <td>@appointment.Name</td>
		                        <td>@appointment.CustomerEmail</td>
		                        <td>@appointment.VehicleLicensePlate</td>
		                        <td>@appointment.MechanicName</td>
		                        <td>@appointment.AppointmentDate.ToString("g")</td>
		                        <td>@appointment.Status</td>
		                        <td>@(appointment.Notes.Length > 50 ? appointment.Notes.Substring(0, 50) + "..." : appointment.Notes)</td>
		                        <td>
			                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-info btn-sm">Details</a>
		                        </td>
	                        </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No appointments for this service.</p>
            }
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                <a asp-action="Index" class="btn btn-primary">Back to List</a>
            </div>
        </div>
    </div>
</div>