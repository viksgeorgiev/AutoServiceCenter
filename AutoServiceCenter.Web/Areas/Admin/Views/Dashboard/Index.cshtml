@{
	ViewData["Title"] = "Admin Dashboard";
}
@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
	<h1>@ViewData["Title"]</h1>
	<div class="row">
		<div class="col-md-6">
			<div class="card">
				<div class="card-body">
					<h5 class="card-title">Manage Mechanics</h5>
					<p class="card-text">View, create, and edit mechanics in the system.</p>
					<a asp-controller="Mechanics" asp-action="Index" class="btn btn-primary">Go to Mechanics</a>
				</div>
			</div>
		</div>
	</div>
</div>	