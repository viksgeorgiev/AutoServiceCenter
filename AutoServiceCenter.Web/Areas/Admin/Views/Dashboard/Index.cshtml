@{
	ViewData["Title"] = "Admin Dashboard";
}
@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" asp-fallback-test-class="btn" asp-fallback-test-property="display" asp-fallback-test-value="inline-block" />
}

<div class="container mt-5">
	<h1>@ViewData["Title"]</h1>
	<div class="row">
		<div class="col-md-6">
			<h3>Admin Actions</h3>
			<ul class="list-group">
				<li class="list-group-item">
					<a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="btn btn-link">Manage Customers</a>
				</li>
				<li class="list-group-item">
					<a asp-area="Admin" asp-controller="Mechanics" asp-action="Index" class="btn btn-link">Manage Mechanics</a>
				</li>
				<li class="list-group-item">
					<a asp-area="Admin" asp-controller="Dashboard" asp-action="ManageRoles" class="btn btn-link">Manage User Roles</a>
				</li>
			</ul>
		</div>
	</div>
</div>
@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
}