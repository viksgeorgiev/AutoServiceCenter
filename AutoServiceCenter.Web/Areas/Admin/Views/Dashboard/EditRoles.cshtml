@using AutoServiceCenter.Web.ViewModels.Admin
@model EditUserRoleViewModel
@{
    ViewData["Title"] = "Edit User Roles";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" asp-fallback-test-class="btn" asp-fallback-test-property="display" asp-fallback-test-value="inline-block" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <h3>User: @Model.Email</h3>
    <div class="row">
        <div class="col-md-6">
            <form asp-area="Admin" asp-controller="Dashboard" asp-action="EditRoles" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                <div class="form-group">
                    <label asp-for="SelectedRoles"></label>
                    @foreach (string role in Model.AvailableRoles)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="SelectedRoles" value="@role" @(Model.CurrentRoles.Contains(role) ? "checked" : "") />
                            <label class="form-check-label">@role</label>
                        </div>
                    }
                    <span asp-validation-error-for="SelectedRoles" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="ManageRoles" class="btn btn-secondary mt-3">Back to List</a>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <partial name="_ValidationScriptsPartial" />
}