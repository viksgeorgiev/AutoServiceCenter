@{
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model AutoServiceCenter.Web.ViewModels.Mechanics.MechanicIndexViewModel
@{
    ViewData["Title"] = "Mechanics";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New Mechanic</a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Email</th>
                <th>Specialization</th>
                <th>Experience (Years)</th>
                <th>Appointments</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (MechanicViewModel mechanic in Model.Mechanics)
            {
                <tr>
                    <td>@mechanic.UserName</td>
                    <td>@mechanic.Specialization</td>
                    <td>@mechanic.ExperienceYears</td>
                    <td>@mechanic.AppointmentCount</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@mechanic.Id" class="btn btn-warning btn-sm">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>